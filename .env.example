# SEC EDGAR requires every request to identify who's making it.
# Format: "Your Name your.email@example.com"
EDGAR_USER_AGENT="Your Name your@email.com"

# OpenAI API key
OPENAI_API_KEY=sk-...

# Local SQLite file for ingestion intermediates (parsed sections, the LLM
# cache) -- optional. Defaults to data/materiality.db (gitignored) if unset;
# only set this to point it somewhere else.
# DATABASE_PATH=data/materiality.db

# Deploying (scripts/deploy.sh, scripts/deploy_frontend.sh) needs AWS
# credentials too, but via the `aws`/`sam` CLIs directly (e.g. `aws
# configure`), not this file -- neither script sources .env.
