# SEC EDGAR requires every request to identify who's making it.
# Format: "Your Name your.email@example.com"
EDGAR_USER_AGENT="Your Name your@email.com"

# OpenAI API key
OPENAI_API_KEY=sk-...

# Postgres connection string (AWS RDS).
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# AWS credentials for deployment (Lambda, Step Functions, API Gateway, SQS, S3, CloudFront).
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1

# News API key for context enrichment.
NEWS_API_KEY=...
